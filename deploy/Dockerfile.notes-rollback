# Privacy-preserving fallback. Never replace this with the pre-privacy image.
ARG CANDIDATE_IMAGE
FROM ${CANDIDATE_IMAGE}
USER root
RUN node --input-type=module -e "import fs from 'node:fs'; const p='/app/public/pages/notes.js'; let s=fs.readFileSync(p,'utf8'); const needle='compact: false, active: true'; if(s.split(needle).length!==2) throw Error('Unexpected Notes compact-mode source'); fs.writeFileSync(p,s.replace(needle,'compact: true, active: true')); fs.appendFileSync('/app/public/styles/notes.css','\n/* Privacy-safe fallback keeps the ordered Notes view. */\n#notes-compact-view { display: none !important; }\n');"
LABEL io.vidamia.notes-rollback="privacy-preserving-compact"
RUN node --input-type=module -e "import fs from 'node:fs'; const p='/app/public/sw.js'; const s=fs.readFileSync(p,'utf8'); const marker='-vidamia.56'; if(s.split(marker).length!==2) throw Error('Unexpected service worker identity'); fs.writeFileSync(p,s.replace(marker,'-vidamia.56-notes-compact'));"
