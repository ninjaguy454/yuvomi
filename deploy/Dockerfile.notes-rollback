# Group-aware recovery. Keep the exact forward backend, schema and private data.
ARG CANDIDATE_IMAGE
FROM ${CANDIDATE_IMAGE}
USER root
COPY deploy/build-notes-fallback.mjs /tmp/build-notes-fallback.mjs
RUN node /tmp/build-notes-fallback.mjs && rm /tmp/build-notes-fallback.mjs
ENV VIDAMIA_NOTE_GROUPS_MUTATIONS=0
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION
LABEL io.vidamia.notes-rollback="group-aware-private-list"
